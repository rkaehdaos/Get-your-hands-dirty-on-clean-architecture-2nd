# 이 저장소가 Lombok 설정의 최상위다 — 상위 디렉터리의 lombok.config를 읽지 않는다.
config.stopBubbling = true

# Lombok이 생성한 코드에 @lombok.Generated를 붙인다. JaCoCo는 이름에 "Generated"가
# 들어간 애노테이션이 붙은 코드를 커버리지에서 빼므로, 자명한 getter/setter 등이
# Cleaned Code Coverage 검증 대상에서 빠진다. 1.18.46의 기본값과 같지만 기본값에
# 기대지 않고 명시한다.
lombok.addLombokGeneratedAnnotation = true
